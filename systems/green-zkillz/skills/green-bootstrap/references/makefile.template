# Generated by green-bootstrap. Native tools only.
GREEN_WORKSPACE ?= .
SKILLS ?= $(HOME)/.grok/skills
export GREEN_WORKSPACE

.PHONY: probe index syntax format manuscript check

probe:
	@GREEN_WORKSPACE=$(GREEN_WORKSPACE) $(SKILLS)/green-probe/scripts/probe.sh

index:
	@$(SKILLS)/green-ingest/scripts/index-tree.sh $(GREEN_WORKSPACE) --max 400

syntax:
	@find $(GREEN_WORKSPACE) -name '*.sh' -print0 | xargs -0 -r -n1 $(SKILLS)/green-ingest/scripts/syntax-check.sh
	@find $(GREEN_WORKSPACE) -name '*.py' -print0 | xargs -0 -r -n1 $(SKILLS)/green-ingest/scripts/syntax-check.sh
	@find $(GREEN_WORKSPACE) -name '*.json' -print0 | xargs -0 -r -n1 $(SKILLS)/green-ingest/scripts/syntax-check.sh

format:
	@test -f $(GREEN_WORKSPACE)/MANUSCRIPT.json || echo "FORMAT manuscript=MISSING"
	@find $(GREEN_WORKSPACE) -name '*.md' -print0 | xargs -0 -r -n1 $(SKILLS)/green-format/scripts/normalize-md.sh >/dev/null

manuscript:
	@$(SKILLS)/green-deploy/scripts/flatten-manuscript.sh $(GREEN_WORKSPACE)/MANUSCRIPT.json $(GREEN_WORKSPACE)/MANUSCRIPT.md

check:
	@find $(GREEN_WORKSPACE) -name '*.sh' -print0 | xargs -0 -r bash -n
	@find $(GREEN_WORKSPACE) -name '*.py' -print0 | xargs -0 -r python3 -m py_compile
